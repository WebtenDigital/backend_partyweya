// ═══════════════════════════════════════════════════════════════════════
//  PartyWeya Supply Register — Prisma schema
//
//  Reconciled against the register sheet on 19 Oct 2026. Three rules the
//  shape follows from:
//
//  1. Ids are typed by hand and readable (tehilas, tehilas-acoustic).
//     No @default(cuid()) anywhere — a blank id must FAIL the import, not
//     be silently replaced by a random string you can never find again.
//  2. A LEAD is allowed to be incomplete. Anything discovered during the
//     week is nullable; anything the public view depends on is checked
//     there instead, so an unfinished row can exist without publishing.
//  3. Controlled vocabularies are enums where the set is closed and a
//     table where the set is still being corrected (see Zone).
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URLs live in prisma.config.ts (DIRECT_URL for the CLI)
// and src/lib/server/prisma.ts (pooled DATABASE_URL for the app).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────
//  CONTROLLED VOCABULARIES
// ─────────────────────────────────────────────────────────────────────

enum Register {
  CHILL
  SOCIAL
  HIGH_ENERGY
}

enum ClaimType {
  VETTED //      PartyWeya attended and judged — the ONLY one that licenses "best"
  TRANSFERRED // a known act or venue with an independent track record
  FACTUAL //     announced and real — licenses "this is happening", nothing more
}

enum OccurrenceStatus {
  LEAD //      found in the weekly scan; nothing verified yet
  CONFIRMED // time and price verified; publishable
  CHANGED //   was confirmed, details have moved — re-verify before use
  CANCELLED
}

enum Category {
  LIVE_BAND
  DJ
  KARAOKE
  QUIZ
  ACOUSTIC
  POETRY
  COMEDY
  BRUNCH
  PAGEANT
  CONCERT
  SPORTS_SCREENING //  was in the sheet's dropdown but not the enum
  THEMED_NIGHT //      same
  MOVIE_NIGHT //       in use on park-and-chill-kyanja
  OTHER
}

enum ConversationTest {
  CAN_TALK //          → CHILL
  ONLY_AT_THE_EDGES // → SOCIAL
  NO //                → HIGH_ENERGY
}

// Where a fact came from. A vocabulary rather than free text so the VETTED
// rule is exhaustive ("only ATTENDED") instead of a blocklist of spellings.
enum Source {
  ATTENDED //      PartyWeya was in the room. The ONLY source that can carry VETTED.
  OWNER //         the venue owner or management said so
  MANAGER
  PROMOTER //      the organiser running the night
  AGENT //         a booking agent — pair with organiserId
  ACT //           the performer told us about their own gig — FACTUAL, confirmed
  TICKETING //     Quicket, Mticket — a listing, not a judgement
  SOCIAL_MEDIA //  the venue's or organiser's own post
  FLYER
  PRESS
  AUDIENCE //      a reader told us. Lowest trust; always needs a call.
}

enum ContactRole {
  MANAGER
  MARKETING
  PROMOTER
  OWNER
  HOST
}

enum Recurrence {
  WEEKLY
  MONTHLY
  SEASONAL
}

enum ActRole {
  BAND
  DJ
  COMEDIAN
  POET
  ACOUSTIC_ACT
  HOST
  ARTIST
  OTHER
}

enum PerkKind {
  DRINK
  FOOD
  ENTRY
  OTHER
}

enum PostType {
  ROUND_UP
  CAROUSEL_CUT
  MOOD_MENU
  MID_WEEK
  LAST_MINUTE
  DISCOVERY
  ZONE_ZOOM_IN
  MOOD_PICK
  HIGHLIGHT
  STORY
}

// ─────────────────────────────────────────────────────────────────────
//  ZONE — a table, not an enum.
//  The map is built on the KCCA parish registers but is still being
//  corrected, and renaming a Postgres enum value is a migration while
//  renaming a row is one UPDATE. The foreign key is what stops this
//  column drifting back into free text — which is how it came to hold
//  area arrays in the first place.
// ─────────────────────────────────────────────────────────────────────

model Zone {
  name      String  @id //  "BUKOTO–NTINDA"
  division  String //       "Nakawa" — the KCCA division or district it sits in
  active    Boolean @default(true)
  sortOrder Int? //      for ordering a zone filter in the UI

  venues Venue[]

  @@index([division])
}

// ─────────────────────────────────────────────────────────────────────
//  VENUE — durable. This is the asset that compounds.
// ─────────────────────────────────────────────────────────────────────

model Venue {
  id   String @id //       typed by hand: "tehilas"
  name String @unique //   exactly as the venue brands itself (feeds the venue tag)
  //                       @unique catches double entry while this is hand-typed.
  //                       Drop it the day two real venues share a name.

  location String? //      navigational: "Kira Rd. next to Distrikt24"
  areas    String[] @default([]) // colloquial: ["Bukoto","Kisaasi","Naguru"]

  zone     Zone?   @relation(fields: [zoneName], references: [name])
  zoneName String? // null = not yet placed. 18 of 239 at import.

  // ── everything above is public-safe. everything below is internal only. ──

  contactName     String?
  contactRole     ContactRole?
  phone           String?
  phoneVerifiedAt DateTime? // set when a call reaches someone; cleared when the number changes
  whatsapp        Boolean      @default(false)
  bestTimeToReach String? //   nightlife staff are not morning people

  conversationTest    ConversationTest? // the call script's register diagnostic
  provisionalRegister Register? //         derived from conversationTest

  lastAttended DateTime? // null = PartyWeya has never been. The basis of VETTED.
  clearsF2     Boolean? //  null = unknown, which is the honest default
  paidClient   Boolean   @default(false) // keeps concentration visible (Rule 6)

  // Facts that don't change by night: would it differ on their Tuesday and their Saturday?
  dressCode   String?
  parkingNote String?
  hasFood     Boolean?

  lastContacted  DateTime?
  nextContactDue DateTime? // set by the cadence tier — drives "who is due this week"
  notes          String?

  residencies Residency[]
  occurrences Occurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([zoneName])
  @@index([nextContactDue])
  @@index([areas], type: Gin) // "which venues are in Bukoto"
}

// ─────────────────────────────────────────────────────────────────────
//  ORGANISER — a promoter, agent or host who is not the venue.
//  Makes "who do we depend on" answerable the way paidClient does for
//  venues, and means the agent behind one concert is someone you can
//  call again rather than a name stranded in a notes field.
// ─────────────────────────────────────────────────────────────────────

model Organiser {
  id   String @id //     "kellen", "blankets-and-wine"
  name String @unique

  contactName String?
  role        ContactRole?
  phone       String?
  whatsapp    Boolean      @default(false)

  paidClient Boolean @default(false)
  notes      String?

  residencies Residency[]
  occurrences Occurrence[]
  acts        Act[] // acts they represent

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
//  RESIDENCY — the recurring rule. One row, indefinitely.
//  Without this you insert ~30 rows a week by hand and the process dies.
//  Monthly confirmation touches one row, which is exactly the standing-
//  roster tier in the call protocol's Part 2.
// ─────────────────────────────────────────────────────────────────────

model Residency {
  id      String @id //   "tehilas-acoustic"
  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String

  organiser   Organiser? @relation(fields: [organiserId], references: [id])
  organiserId String? //  set when a promoter runs the night, not the venue

  eventName String
  category  Category
  dayOfWeek Int //        1 = Monday … 7 = Sunday
  startTime String? //    "19:00" — local wall-clock, no timezone arithmetic.
  //                      Nullable: 9 of 20 standing nights don't have it yet.
  endTime   String?

  priceGate Int? //       renamed from costGate. There is no priceAdvance here:
  //                      a residency fee is set once and never changed.

  register Register //    REQUIRED, deliberately. This is the field Rule F4
  //                      (mood balance) depends on, and the one that has drifted
  //                      to 14 HIGH_ENERGY / 6 SOCIAL / 0 CHILL by being copied
  //                      from the category. Making it required forces the call.

  recurrence    Recurrence @default(WEEKLY)
  runningSince  DateTime? //  the durability signal: a year beats a month
  active        Boolean    @default(true)
  stoppedReason String? //   why it was deactivated — asked for on Deactivate
  stoppedAt     DateTime? // when

  lastConfirmed DateTime? // drives the monthly sweep
  claimType     ClaimType? // what PartyWeya may say about the standing night
  source        Source? //    who confirmed it; only ATTENDED can carry VETTED
  notes         String? // internal — never public
  lineup        String[]   @default([]) // the billing as advertised, in order — authoritative; resolved to Acts by name

  occurrences Occurrence[]
  perks       Perk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([venueId, dayOfWeek, eventName])
  @@index([dayOfWeek, active])
  @@index([lineup], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────
//  OCCURRENCE — a dated instance. One-offs, and overrides of a residency.
//  A residency generates its weeks in application code; an Occurrence row
//  exists only when something is one-off, cancelled, or different from
//  the standing rule that week.
// ─────────────────────────────────────────────────────────────────────

model Occurrence {
  id   String   @id
  date DateTime @db.Date

  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String

  residency   Residency? @relation(fields: [residencyId], references: [id])
  residencyId String? //  set = this row OVERRIDES a residency for this date.
  //                      Leave it null only for a genuine one-off, or the
  //                      Sunday query emits the residency and this row both.

  organiser   Organiser? @relation(fields: [organiserId], references: [id])
  organiserId String?

  eventName String
  category  Category

  startTime String? //    nullable while LEAD; the public view requires it
  endTime   String?

  priceGate    Int?
  priceAdvance Int? //    must be cheaper than priceGate — checked in SQL below
  priceNote    String? // "165K PRE | 190K AT THE GATE" — the tiers as advertised

  lineup   String[]  @default([]) // the billing that night, in order; empty = the standing night's
  register Register?

  claimType ClaimType? // what PartyWeya is allowed to say about this row
  source    Source? //    where the fact came from; only ATTENDED can carry VETTED

  status      OccurrenceStatus @default(LEAD)
  confirmedOn DateTime?
  confirmedBy String? //  accountability when a published fact turns out wrong

  publications Publication[]
  perks        Perk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([venueId, date, eventName])
  @@index([date, status])
  @@index([lineup], type: Gin)
}

// ─────────────────────────────────────────────────────────────────────
//  PUBLICATION — where an entry actually travelled.
//  Rule F7 (measurement) needs to answer "which entries pulled people
//  through", which nothing else records. Written by the app on publish,
//  never by hand. Cheap now, annoying to backfill later.
// ─────────────────────────────────────────────────────────────────────

model Publication {
  id           String     @id @default(cuid()) // the one table the app creates,
  //                                              so a generated id is right here
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id])
  occurrenceId String

  postType PostType
  platform String //    instagram | tiktok | snapchat
  postedAt DateTime
  postUrl  String?

  @@index([postedAt])
  @@index([postType])
}

// ─────────────────────────────────────────────────────────────────────
//  PERK — an offer on a standing night or a dated one (exactly one of the
//  two; enforced by a CHECK in SQL). A table, not a text field, because
//  offers go stale fastest and a wrong one costs more than a missing one:
//  activeUntil lets a seasonal promo expire itself.
// ─────────────────────────────────────────────────────────────────────

model Perk {
  id           String      @id @default(cuid())
  residency    Residency?  @relation(fields: [residencyId], references: [id], onDelete: Cascade)
  residencyId  String?
  occurrence   Occurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceId String?
  kind         PerkKind
  label        String //    "Half-price cocktails"
  condition    String? //   "before 9pm"
  activeUntil  DateTime? // last day it holds; null = until told otherwise
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([residencyId])
  @@index([occurrenceId])
}

// ─────────────────────────────────────────────────────────────────────
//  ACT — the performers PartyWeya has taken a view on. Purely additive:
//  no join table, no foreign key from a lineup. A lineup name resolves to
//  an act by matching name or any alias, trimmed and case-insensitively,
//  so merging two acts moves a name into aliases and never rewrites a
//  billing. A name with no Act row is simply unclassified.
// ─────────────────────────────────────────────────────────────────────

model Act {
  id            String     @id //            slug: "the-clan-band"
  name          String     @unique //        canonical billing
  aliases       String[]   @default([]) //   other spellings seen in the wild
  role          ActRole? //                   null = not yet classified
  transfers     Boolean? //                   null = not decided; true licenses TRANSFERRED
  transfersNote String? //                    why — required when transfers is true
  lastSeen      DateTime? //                  when PartyWeya last saw them
  organiser     Organiser? @relation(fields: [organiserId], references: [id], onDelete: SetNull)
  organiserId   String? //                    their agent, where they have one
  notes         String?

  // Internal contact, laid out like the venue's. Never reaches public_events.
  contactName     String?
  phone           String?
  whatsapp        Boolean   @default(false)
  bestTimeToReach String?
  phoneVerifiedAt DateTime? // set on a call that reaches them; cleared when the number changes
  lastContacted   DateTime?
  paidClient      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([aliases], type: Gin)
}

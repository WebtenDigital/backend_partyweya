# Supabase → Connect. Replace [PASSWORD] and the project ref/region.

# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Migrations: direct connection (port 5432, IPv6-only),
# or the session pooler on port 5432 if your network is IPv4-only
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Internal tool login (single user). SESSION_SECRET: openssl rand -base64 48
ADMIN_PASSWORD="[AT-LEAST-16-CHARS]"
SESSION_SECRET="[AT-LEAST-32-CHARS]"

# Who is logging calls (confirmedBy)
CALLER_NAME="[INITIALS]"

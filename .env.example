# Supabase → Connect. Replace [PASSWORD] and the project ref/region.

# Runtime: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Migrations: direct connection (port 5432, IPv6-only),
# or the session pooler on port 5432 if your network is IPv4-only
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
